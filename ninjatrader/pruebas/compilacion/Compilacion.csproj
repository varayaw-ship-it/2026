<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compila PrimerIFVG.cs completo contra Imitacion.cs: una imitación mínima de la API de NinjaTrader 8 y WPF
       con las firmas que usa el indicador. Detecta errores de C# 7.3 y de tipeo; no reemplaza compilar en NinjaTrader. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0067;CS0649;CS0169;CS0414;SYSLIB0014</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../PrimerIFVG.cs" />
    <Compile Include="Imitacion.cs" />
  </ItemGroup>
</Project>
